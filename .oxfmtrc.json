{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "ignorePatterns": [
    "/AGENTS.md",
    "/docs/index.md",
    "docs/_shared/**",
    ".agents/skills/**",
    "tasks/**"
  ],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false
}
