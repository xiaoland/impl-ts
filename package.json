{
  "name": "@inkcre/web-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs web",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:all:ui": "node scripts/dev-ui.mjs --with-remotes",
    "dev:webext": "node scripts/dev.mjs webext",
    "dev:status": "svc dev status --repo . --json",
    "dev:stop": "node scripts/dev-stop.mjs",
    "db:ready": "node scripts/database-runtime.mjs ready",
    "db:reset": "node scripts/database-runtime.mjs reset --yes",
    "contract:sync": "node scripts/sync-database-contract.mjs",
    "contract:check": "node scripts/sync-database-contract.mjs --check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm -r --filter './extensions/*' dev\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:type-aware": "pnpm lint",
    "type-check": "pnpm check:workspace && pnpm check:runtime && pnpm check:database && pnpm check:locale && pnpm -r run type-check",
    "type-check:ui": "node scripts/type-check-ui.mjs",
    "check:runtime": "node --test scripts/tests/browser-runtime-contract.test.mjs scripts/tests/database-probe.test.mjs scripts/tests/ui-source.test.mjs && node scripts/check-local-runtime-contract.mjs",
    "check:database": "node scripts/check-database-contract.mjs",
    "check:release:web": "node scripts/verify-client-web-release.mjs",
    "check:locale": "node scripts/check-locale-keys.mjs",
    "check:workspace": "node scripts/check-workspace-contract.mjs",
    "check:package": "node scripts/check-package-contract.mjs",
    "test:e2e": "pnpm test:e2e:web && pnpm test:e2e:webext",
    "test:e2e:web": "node scripts/test-e2e.mjs",
    "test:e2e:webext": "node scripts/test-webext-e2e.mjs",
    "verify:twitter": "playwright test --config scripts/tests/twitter-acceptance.config.ts",
    "verify:core-release": "node --test scripts/tests/core-release.test.mjs",
    "build": "pnpm check:workspace && pnpm -r run build && pnpm check:package",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm build",
    "ci": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@playwright/test": "1.61.1",
    "@tanstack/intent": "0.3.6",
    "@types/semver": "7.5.8",
    "@vitejs/plugin-vue": "6.0.3",
    "concurrently": "^9.0.0",
    "jose": "6.1.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.12.0",
    "semver": "7.8.5",
    "supabase": "2.112.0",
    "typescript": "catalog:",
    "wrangler": "4.114.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.11.0"
}
